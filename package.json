{
  "name": "dsh-openspec-taskloop",
  "version": "0.1.0",
  "description": "Host plugin for DeepSeek Harness: orchestrates an OpenSpec apply run — one task per turn, completion read from tasks.md, controllable compaction and a session handoff on task-group boundaries",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "engines": {
    "node": ">=22.8"
  },
  "scripts": {
    "test": "node --test --test-isolation=none \"test/**/*.test.mjs\""
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  }
}
