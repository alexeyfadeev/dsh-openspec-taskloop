# pnpm on this Windows host cannot create usable package symlinks: it falls back
# to junctions whose realpath Node's ESM resolver does not follow, so importing
# a dependency of a dependency (schemastery -> @deepseek-ai/cosmokit) failed with
# ERR_MODULE_NOT_FOUND. The hoisted layout installs real directories and keeps
# `node --test` runnable; the package layout this repo publishes is unaffected.
node-linker=hoisted
